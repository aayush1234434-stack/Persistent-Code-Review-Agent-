ENVIRONMENT=development
GITHUB_WEBHOOK_SECRET=replace_me
GITHUB_TOKEN=replace_me
DATABASE_URL=postgresql://user:password@localhost:5432/pr_review
OPENAI_API_KEY=replace_me
OPENAI_TRIAGE_MODEL=gpt-4o-mini
OPENAI_REVIEW_MODEL=gpt-4o-mini
OPENAI_STRONG_REVIEW_MODEL=gpt-4o
DASHBOARD_API_KEY=replace_me
HTTP_TIMEOUT_SECONDS=20
GITHUB_CHECK_RUN_NAME=PR Reviewer
REVIEW_WORKER_ENABLED=true
REVIEW_JOB_MAX_ATTEMPTS=5
REVIEW_JOB_LEASE_SECONDS=180
REVIEW_JOB_POLL_SECONDS=1
REVIEW_JOB_BACKOFF_SECONDS=5
REVIEW_JOB_MAX_BACKOFF_SECONDS=300
REVIEW_INTELLIGENCE_ENABLED=true
REVIEW_SANDBOX_MODE=local
REVIEW_SANDBOX_ROOT=/tmp/pr-review-sandbox
REVIEW_SANDBOX_REQUEST_TIMEOUT_SECONDS=900
REVIEW_SANDBOX_COMMAND_TIMEOUT_SECONDS=300
REVIEW_MAX_IMPACTED_FILES=40
REVIEW_RETAIN_SANDBOX=false
REVIEW_ALLOW_LOCAL_TEST_EXECUTION=false
